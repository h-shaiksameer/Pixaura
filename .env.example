# Copy this file to .env.local for local use, or add these values in Vercel.
# Replace every placeholder before deploying publicly.
NEXT_PUBLIC_SITE_NAME=Pixaura
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Optional. Keep blank until the accounts are created.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ANALYTICS_ID=
